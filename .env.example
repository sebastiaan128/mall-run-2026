# Kopieer dit bestand naar ".env" en vul de waarden in vanuit je Firebase-project
# (Firebase console -> Projectinstellingen -> Algemeen -> Je apps -> SDK-configuratie).
# ".env" staat in .gitignore en wordt dus niet gecommit.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
