rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Campagne-instellingen (opgehaald bedrag, doel, stretchgoal):
    // iedereen mag lezen (nodig voor de live voortgangsbalk), alleen
    // ingelogde admins mogen schrijven.
    match /settings/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Deelnemers: publiek zichtbaar, alleen admins mogen toevoegen/wijzigen/verwijderen.
    match /participants/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Inschrijvingen: iedereen mag er ÉÉN aanmaken (het formulier), maar
    // niemand van buiten mag ze lezen, wijzigen of verwijderen — dat kan
    // persoonsgegevens (e-mail, telefoon) bevatten. Alleen ingelogde admins
    // mogen ze inzien/beheren.
    match /registrations/{docId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }
  }
}
